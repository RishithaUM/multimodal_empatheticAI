# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your_secret_key_here
DEBUG=True

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/emotion_detection?retryWrites=true&w=majority
MONGODB_DB=emotion_detection

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Email Configuration
EMAIL_SERVICE_PROVIDER=gmail  # or sendgrid, aws_ses
EMAIL_FROM_ADDRESS=your_email@gmail.com
EMAIL_API_KEY=your_email_api_key
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# WebSocket Configuration
SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0  # Optional: for production
SOCKETIO_PING_TIMEOUT=60
SOCKETIO_PING_INTERVAL=25

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ML Model Configuration
MODEL_DEVICE=cuda  # or cpu
MODEL_PRECISION=fp32  # or fp16 for faster inference
FACE_DETECTION_MODEL=resnet50  # or vit, mobilenet
VOICE_EMOTION_MODEL=kvilla  # or wav2vec2
TEXT_EMOTION_MODEL=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_EMOTION_FUSION=true
ENABLE_DISTRESS_DETECTION=true
ENABLE_REAL_TIME_STREAMING=true
MAX_EMOTION_HISTORY=200
EMOTION_CACHE_TTL=300  # seconds
